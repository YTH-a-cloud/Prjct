pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo "Code checked out successfully via SCM Jenkinsfile"
            }
        }
        stage('Build') {
            steps {
                script {
                    // Define meaningful image parameters
                    // BUILD_NUMBER is a built-in Jenkins environment variable that increments per build
                    env.IMAGE_NAME = "my-web-app"
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"
                    
                    echo "Building Docker image: ${env.IMAGE_NAME}:${env.IMAGE_TAG}..."
                    
                    // Execute the docker build command pointing to the current workspace (.)
                    sh "docker build -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} -t ${env.IMAGE_NAME}:latest ."
                }
            }
        }
    }
}
