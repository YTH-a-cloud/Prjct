pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                // When using Pipeline from SCM, Jenkins automatically 
                // checks out the repo code into the workspace prior to execution.
                // We can add a simple verification command here:
                sh 'echo "Successfully checked out code via SCM Jenkinsfile"'
                sh 'ls -la'
            }
        }
    }
}
